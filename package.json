{
  "name": "pand4",
  "version": "1.0.6",
  "description": "Pand4 - A modern, modular and responsive SCSS framework",
  "main": "./src/styles/pand4/dist/pand4.css",
  "style": "./src/styles/pand4/dist/pand4.css",
  "sass": "./src/styles/pand4/scss/pand4.scss",
  "type": "module",
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "exports": {
    ".": {
      "sass": "./src/styles/pand4/scss/pand4.scss",
      "default": "./src/styles/pand4/dist/pand4.css"
    },
    "./scss": "./src/styles/pand4/scss/_index.scss",
    "./dist/pand4.css": "./src/styles/pand4/dist/pand4.css",
    "./dist/pand4.min.css": "./src/styles/pand4/dist/pand4.min.css",
    "./dist/pand4-nano.css": "./src/styles/pand4/dist/pand4-nano.css",
    "./dist/pand4-nano.min.css": "./src/styles/pand4/dist/pand4-nano.min.css",
    "./dist/pand4-utilities.css": "./src/styles/pand4/dist/pand4-utilities.css",
    "./dist/pand4-utilities.min.css": "./src/styles/pand4/dist/pand4-utilities.min.css",
    "./dist/pand4-dark-theme.css": "./src/styles/pand4/dist/pand4-dark-theme.css",
    "./dist/pand4-dark-theme.min.css": "./src/styles/pand4/dist/pand4-dark-theme.min.css",
    "./dist/pand4-atomic.css": "./src/styles/pand4/dist/pand4-atomic.css",
    "./dist/pand4-atomic.min.css": "./src/styles/pand4/dist/pand4-atomic.min.css"
  },
  "files": [
    "src/styles/pand4/scss/**/*",
    "src/styles/pand4/dist/**/*",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": "18.x || 20.x || 22.x",
    "npm": ">=9.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "compile-css": "npm run compile-css:full && npm run compile-css:nano && npm run compile-css:utilities && npm run compile-css:dark-theme && npm run compile-css:atomic",
    "compile-css:full": "sass ./src/styles/pand4/scss/pand4.scss ./src/styles/pand4/dist/pand4.css --style=expanded --no-source-map",
    "compile-css:nano": "sass ./src/styles/pand4/scss/pand4-nano.scss ./src/styles/pand4/dist/pand4-nano.css --style=expanded --no-source-map",
    "compile-css:utilities": "sass ./src/styles/pand4/scss/pand4-utilities.scss ./src/styles/pand4/dist/pand4-utilities.css --style=expanded --no-source-map",
    "compile-css:dark-theme": "sass ./src/styles/pand4/scss/pand4-dark-theme.scss ./src/styles/pand4/dist/pand4-dark-theme.css --style=expanded --no-source-map",
    "compile-css:atomic": "sass ./src/styles/pand4/scss/pand4-atomic.scss ./src/styles/pand4/dist/pand4-atomic.css --style=expanded --no-source-map",
    "compile-css:min": "npm run compile-css:full:min && npm run compile-css:nano:min && npm run compile-css:utilities:min && npm run compile-css:dark-theme:min && npm run compile-css:atomic:min",
    "compile-css:full:min": "sass ./src/styles/pand4/scss/pand4.scss ./src/styles/pand4/dist/pand4.min.css --style=compressed",
    "compile-css:nano:min": "sass ./src/styles/pand4/scss/pand4-nano.scss ./src/styles/pand4/dist/pand4-nano.min.css --style=compressed",
    "compile-css:utilities:min": "sass ./src/styles/pand4/scss/pand4-utilities.scss ./src/styles/pand4/dist/pand4-utilities.min.css --style=compressed",
    "compile-css:dark-theme:min": "sass ./src/styles/pand4/scss/pand4-dark-theme.scss ./src/styles/pand4/dist/pand4-dark-theme.min.css --style=compressed",
    "compile-css:atomic:min": "sass ./src/styles/pand4/scss/pand4-atomic.scss ./src/styles/pand4/dist/pand4-atomic.min.css --style=compressed",
    "compile-css:watch": "sass ./src/styles/pand4/scss/:./src/styles/pand4/dist/ --style=expanded --watch",
    "compile-docs": "sass ./src/styles/docs.scss ./src/styles/docs.css --style=expanded --no-source-map",
    "compile-all": "npm run compile-css && npm run compile-css:min && npm run compile-docs",
    "purge": "postcss ./src/styles/pand4/dist/pand4-atomic.css --output ./src/styles/pand4/dist/pand4-atomic.purged.css",
    "clean": "rm -f ./src/styles/pand4/dist/*.css ./src/styles/pand4/dist/*.css.map ./src/styles/*.css ./src/styles/*.css.map",
    "test": "echo \"No tests configured yet\"",
    "prepublishOnly": "npm run clean && npm run compile-all",
    "postpublish": "echo '🎉 Pand4 published successfully to NPM!'",
    "version": "npm run clean && npm run compile-all && git add .",
    "postversion": "git push && git push --tags"
  },
  "keywords": [
    "css",
    "scss",
    "sass",
    "framework",
    "responsive",
    "pand4",
    "frontend",
    "ui",
    "design-system",
    "modular",
    "tree-shakeable",
    "tree-shaking"
  ],
  "author": "bascoy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bascoy/pand4.git"
  },
  "homepage": "https://pand4.vercel.app",
  "bugs": {
    "url": "https://github.com/bascoy/pand4/issues"
  },
  "devDependencies": {
    "@astrojs/vercel": "^8.2.11",
    "@fullhuman/postcss-purgecss": "^7.0.2",
    "astro": "^5.14.8",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "sass": "^1.93.2"
  },
  "peerDependencies": {
    "sass": "^1.50.0"
  }
}

---
import Layout from '../layouts/Layout.astro';
import DemoBlock from '../components/DemoBlock.astro';
import CodeBlock from '../components/CodeBlock.astro';

const installCode = `# NPM
npm install pand4

# Yarn
yarn add pand4

# PNPM
pnpm add pand4`;

const cssImportCode = `/* En tu archivo CSS */
@import 'pand4/css';`;

const jsUsageCode = `// CSS completo
import 'pand4/css';

// CSS minificado (producción)
import 'pand4/min.css';`;

const htmlUsageCode = `<!-- CSS completo -->
<link rel="stylesheet" href="node_modules/pand4/css">

<!-- CSS minificado -->
<link rel="stylesheet" href="node_modules/pand4/min.css">`;

const cssCustomizationCode = `/* ✅ Método recomendado: CSS Variables */
:root {
  --p4-primary-500: #3b82f6;
  --p4-secondary-500: #64748b;
  --p4-font-family-base: 'Inter', sans-serif;
  --p4-font-size-base: 16px;
  --p4-spacer-base: 8px;
}`;

const scssCustomizationCode = `/* ⚠️ Solo para casos específicos (breakpoints, containers) */
@use 'pand4' as * with (
  $breakpoint-sm: 640px,
  $breakpoint-md: 768px,
  $breakpoint-lg: 1024px,
  $container-max-width: 1200px
);`;

const buttonExampleHtml = `<button class="p4-btn">
  Botón Principal
</button>

<button class="p4-btn p4-btn--ghost">
  Botón Ghost
</button>

<button class="p4-btn p4-btn--naked">
  Botón Naked
</button>`;

const buttonIconExampleHtml = `<button class="p4-btn p4-btn--icon" aria-label="Menú">
  <svg width="20" height="20" viewBox="0 0 24 24">
    <path d="M3 12h18M3 6h18M3 18h18" stroke="currentColor" stroke-width="2"/>
  </svg>
</button>`;

const utilityExampleHtml = `<div class="p4-d-flex p4-gap-16 p4-items-center">
  <div class="p4-p-16 p4-bg-primary-500 p4-text-white">
    Box 1
  </div>
  <div class="p4-p-16 p4-bg-secondary-500 p4-text-white">
    Box 2
  </div>
</div>`;

const utilityLinkHtml = `<a href="/utilidades/espacios" class="p4-btn">
  Ver Utilidades de Espaciado
</a>`;

const iconLinkHtml = `<a href="/icons" class="p4-btn">
  Ver Galería de Iconos
</a>`;

const npmBadges = {
  version: 'https://img.shields.io/npm/v/pand4',
  downloads: 'https://img.shields.io/npm/dm/pand4',
  license: 'https://img.shields.io/npm/l/pand4',
  size: 'https://img.shields.io/bundlephobia/minzip/pand4'
};
---

<Layout 
	title="Pand4 Framework - CSS moderno y responsive"
	description="Un framework CSS moderno, modular y responsive construido con SCSS. Fácil de usar, personalizable y optimizado para rendimiento."
	currentPage="home"
>
	<div class="docs-title">
		<p class="docs-title__h">Inicio</p>
		<span class="docs-title__counter">01</span>
	</div>

	<section id="introduccion" class="docs-section">
		<h1>Pand4 Framework</h1>
		<p>Un framework CSS moderno, modular y responsive construido con SCSS.</p>

		<div class="docs-npm-badges">
			<a href="https://www.npmjs.com/package/pand4" target="_blank" rel="noopener noreferrer">
				<img src={npmBadges.version} alt="Versión NPM" loading="lazy" />
			</a>
			<a href="https://www.npmjs.com/package/pand4" target="_blank" rel="noopener noreferrer">
				<img src={npmBadges.downloads} alt="Descargas mensuales" loading="lazy" />
			</a>
			<a href="https://github.com/bascoy/pand4/blob/main/LICENSE" target="_blank" rel="noopener noreferrer">
				<img src={npmBadges.license} alt="Licencia" loading="lazy" />
			</a>
			<a href="https://bundlephobia.com/package/pand4" target="_blank" rel="noopener noreferrer">
				<img src={npmBadges.size} alt="Tamaño del bundle" loading="lazy" />
			</a>
		</div>
	</section>

	<section id="instalacion" class="docs-section">
		<h2>🚀 Instalación</h2>
		<p>Instala Pand4 usando tu gestor de paquetes favorito:</p>
		
		<CodeBlock language="bash" code={installCode} />
	</section>

	<section id="uso-basico" class="docs-section">
		<h2>📖 Uso Básico</h2>
		
		<h3>En CSS</h3>
		<CodeBlock language="css" code={cssImportCode} />

		<h3>En JavaScript</h3>
		<CodeBlock language="javascript" code={jsUsageCode} />

		<h3>En HTML</h3>
		<CodeBlock language="html" code={htmlUsageCode} />
	</section>

	<section id="personalizacion" class="docs-section">
		<h2>🎨 Personalización</h2>
		
		<h3>✅ Con CSS Variables (Recomendado)</h3>
		<p>La forma más sencilla y flexible de personalizar Pand4 es mediante CSS custom properties:</p>
		<CodeBlock language="css" code={cssCustomizationCode} />
		
		<div class="docs-alert docs-alert--success">
			<strong>Ventajas:</strong> No requiere recompilar SCSS, cambios en tiempo real, fácil mantenimiento, mejor rendimiento.
		</div>

		<h3>⚠️ Con SCSS (Solo casos específicos)</h3>
		<p>Solo para configuración de breakpoints y contenedores. <strong>No recomendable</strong> para colores, tipografía o espaciado:</p>
		<CodeBlock language="scss" code={scssCustomizationCode} />
		
		<div class="docs-alert docs-alert--warning">
			<strong>Nota:</strong> Este método requiere recompilar SCSS y solo debe usarse para configuración estructural del grid/layout.
		</div>
	</section>

	<section id="utilidades" class="docs-section">
		<h2>🔧 Utilidades</h2>
		<p>Explora las utilidades disponibles en Pand4:</p>
		
		<DemoBlock 
			title="Enlaces a Utilidades"
			htmlCode={utilityLinkHtml}
		>
			<a 
				href="/utilidades/espacios" 
				class="p4-btn"
			>
				Ver Utilidades de Espaciado
			</a>
		</DemoBlock>
	</section>

	<section id="iconos" class="docs-section">
		<h2>🎨 Iconos</h2>
		<p>Sistema de iconos SVG con carga dinámica:</p>
		
		<DemoBlock 
			title="Sistema de Iconos"
			htmlCode={iconLinkHtml}
		>
			<a 
				href="/icons" 
				class="p4-btn"
			>
				Ver Galería de Iconos
			</a>
		</DemoBlock>
	</section>

	<section id="ejemplos" class="docs-section">
		<h2>✨ Ejemplos</h2>
		<p>Aquí algunos ejemplos de componentes construidos con Pand4:</p>
		
		<DemoBlock 
			title="Botones"
			htmlCode={buttonExampleHtml}
		>
			<button class="p4-btn">Botón Principal</button>
			<button class="p4-btn p4-btn--ghost">Botón Ghost</button>
			<button class="p4-btn p4-btn--naked">Botón Naked</button>
		</DemoBlock>

		<DemoBlock 
			title="Botón con Icono"
			htmlCode={buttonIconExampleHtml}
		>
			<button class="p4-btn p4-btn--icon" aria-label="Menú">
				<svg width="20" height="20" viewBox="0 0 24 24" fill="none">
					<path d="M3 12h18M3 6h18M3 18h18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
				</svg>
			</button>
		</DemoBlock>

		<DemoBlock 
			title="Utilidades de Layout"
			htmlCode={utilityExampleHtml}
		>
			<div class="p4-d-flex p4-gap-16 p4-items-center">
				<div class="p4-p-16 p4-bg-primary-500 p4-text-white">Box 1</div>
				<div class="p4-p-16 p4-bg-secondary-500 p4-text-white">Box 2</div>
			</div>
		</DemoBlock>
	</section>

	<section id="contribuir" class="docs-section">
		<h2>🤝 Contribuir</h2>
		<p>¡Las contribuciones son bienvenidas! Visita nuestro <a href="https://github.com/bascoy/pand4" target="_blank" rel="noopener noreferrer">repositorio en GitHub</a> para más información.</p>
		
		<div class="docs-alert docs-alert--info">
			<strong>Desarrollo:</strong> Este framework está en desarrollo activo. ¡Tu feedback es muy valioso!
		</div>
	</section>
</Layout>

---
export interface Props {
	title?: string;
	description?: string;
	keywords?: string;
	currentPage?: string;
}

const { 
	title = 'Pand4 Framework - CSS moderno y responsive', 
	description = 'Un framework CSS moderno, modular y responsive construido con SCSS. Fácil de usar, personalizable y optimizado para rendimiento.',
	keywords = 'css, scss, sass, framework, responsive, pand4, frontend, ui, design-system, mobile-first, utilities, components',
	currentPage = 'home'
} = Astro.props;

import '../styles/docs.scss';
import Icon from '../components/Icon.astro';

const currentYear = new Date().getFullYear();
const isActive = (page: string) => currentPage === page ? 'is-active' : '';
---

<!DOCTYPE html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/src/assets/images/icons/p4-logo.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="author" content="bascoy" />
		<meta name="keywords" content={keywords} />
		
		<!-- Open Graph Meta Tags -->
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://pand4.vercel.app" />
		<meta property="og:site_name" content="Pand4 Framework" />
		
		<!-- Twitter Card Meta Tags -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		
		<!-- Canonical URL -->
		<link rel="canonical" href="https://pand4.vercel.app" />
		
		<title>{title}</title>
	</head>
	<body class="p4-min-h-100dvh p4-d-flex p4-flex-column p4-items-stretch p4-justify-start">
		<!-- Header -->
		<header class="docs-header">
			<div class="docs-header__handler p4-container">
				<nav class="docs-nav p4-d-flex p4-flex-row p4-flex-wrap p4-items-center">
					<a href="/" class="docs-logo p4-d-flex p4-flex-column">
						<Icon name="panda-logo" />
					</a>
					<span class="docs-radiator">
						<span class="docs-radiator__item"></span>
						<span class="docs-radiator__item"></span>
						<span class="docs-radiator__item"></span>
						<span class="docs-radiator__item"></span>
						<span class="docs-radiator__item"></span>
						<span class="docs-radiator__item"></span>
						<span class="docs-radiator__item"></span>
						<span class="docs-radiator__item"></span>
						<span class="docs-radiator__item"></span>
						<span class="docs-radiator__item"></span>
						<span class="docs-radiator__item"></span>
						<span class="docs-radiator__item"></span>
						<span class="docs-radiator__item"></span>
						<span class="docs-radiator__item"></span>
						<span class="docs-radiator__item"></span>
						<span class="docs-radiator__item"></span>
						<span class="docs-radiator__item"></span>
						<span class="docs-radiator__item"></span>
						<span class="docs-radiator__item"></span>
					</span>
					<button class="docs-menu-toggle md:p4-d-none p4-btn p4-btn--naked-inverse p4-btn--icon" aria-label="Abrir menú" aria-expanded="false">
						<Icon name="more-vertical" styleClass="p4-w-24" />
					</button>
					<div class="docs-menu">
						<ul class="docs-menu__list">
							<li class="docs-menu__item"><a class={`docs-menu__link ${isActive('home')}`} href="/">Inicio</a></li>
							<!--
							<li class="docs-menu__item"><a class={`docs-menu__link ${isActive('getting-started')}`} href="/getting-started">Empezar</a></li>
							<li class="docs-menu__item"><a class={`docs-menu__link ${isActive('components')}`} href="/components">Componentes</a></li>
							<li class="docs-menu__item"><a class={`docs-menu__link ${isActive('utilities')}`} href="/utilities">Utilidades</a></li>
							-->
							<li class="docs-menu__item"><a class="docs-menu__link" href="https://github.com/bascoy/pand4" target="_blank" rel="noopener noreferrer">GitHub</a></li>
							<li class="docs-menu__item"><a class="docs-menu__link" href="https://www.npmjs.com/package/pand4" target="_blank" rel="noopener noreferrer">NPM</a></li>
						</ul>
					</div>
				</nav>
			</div>
		</header>

		<!-- Contenido Principal -->
		<div class="docs-body">
			<main class="docs-body__handler p4-container">
				<!-- Contenido -->
				<div class="docs-content">
					<slot />
				</div>
			</main>
		</div>

		<!-- Footer -->
		<footer class="docs-footer">
			<div class="docs-footer__handler p4-container p4-d-flex p4-flex-column p4-flex-center p4-items-stretch p4-pt-20 p4-pb-20 p4-text-center">
				<p>
					© {currentYear} <a href="https://github.com/bascoy">bascoy</a> - 
					Pand4 Framework bajo licencia 
					<a href="https://github.com/bascoy/pand4/blob/main/LICENSE">MIT</a>
				</p>
				<p>
					Hecho con ❤️ para la comunidad de desarrolladores
				</p>
			</div>
		</footer>

		<script>
			// Mobile menu toggle
			function initMobileMenu() {
				const menuToggle = document.querySelector<HTMLButtonElement>('.docs-menu-toggle');
				const menu = document.querySelector<HTMLElement>('.docs-menu');
				
				if (!menuToggle || !menu) return;

				const body = document.body;
				
				const closeMenu = () => {
					menu.classList.remove('is-open');
					menuToggle.setAttribute('aria-expanded', 'false');
					body.classList.remove('is-locked');
				};

				const toggleMenu = () => {
					const isOpen = menu.classList.toggle('is-open');
					menuToggle.setAttribute('aria-expanded', String(isOpen));
					body.classList.toggle('is-locked', isOpen);
				};

				// Toggle button
				menuToggle.addEventListener('click', toggleMenu);

				// Close on backdrop click
				document.addEventListener('click', (e) => {
					const target = e.target as Node;
					const menuList = menu.querySelector('.docs-menu__list');
					
					if (
						menu.classList.contains('is-open') && 
						menuList &&
						!menuList.contains(target) && 
						!menuToggle.contains(target)
					) {
						closeMenu();
					}
				});

				// Close on link click
				const menuLinks = menu.querySelectorAll<HTMLAnchorElement>('.docs-menu__link');
				menuLinks.forEach(link => {
					link.addEventListener('click', closeMenu);
				});

				// Close on Escape key
				document.addEventListener('keydown', (e) => {
					if (e.key === 'Escape' && menu.classList.contains('is-open')) {
						closeMenu();
						menuToggle.focus(); // Devolver foco al botón
					}
				});
			}

			// Inicializar en carga y en cada navegación de Astro
			initMobileMenu();
			document.addEventListener('astro:page-load', initMobileMenu);
		</script>
	</body>
</html>